{
  "env": { "browser": true, "es2022": true },
  "extends": ["eslint:recommended"],
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "globals": {
    "yaw": "writable",
    "pitch": "writable",
    "player2Yaw": "writable",
    "player2Pitch": "writable",
    "stamina": "writable",
    "stamina2": "writable",
    "sprintExhausted": "writable",
    "sprintExhausted2": "writable",
    "footstepTimer": "writable",
    "fear": "writable",
    "fear2": "writable",
    "p1Sanity": "writable",
    "p2Sanity": "writable",
    "p1HeartRate": "writable",
    "p2HeartRate": "writable",
    "isPlayerHidden": "writable",
    "isPlayer2Hidden": "writable",
    "isHoldingBreath": "writable",
    "isHoldingBreath2": "writable",
    "p1BreathStamina": "writable",
    "p2BreathStamina": "writable",
    "activeNoiseEventZ": "writable",
    "noiseInvestigateTimer": "writable",
    "battery": "writable",
    "battery2": "writable",
    "flashlightOn": "writable",
    "flashlightOn2": "writable",
    "emfActive": "writable",
    "emfActive2": "writable",
    "emfLevel": "writable",
    "emfLevel2": "writable",
    "emfTickTimer": "writable",
    "emfTickTimer2": "writable",
    "p1LockerMinigameActive": "writable",
    "p2LockerMinigameActive": "writable",
    "p1LockerMinigameProgress": "writable",
    "p2LockerMinigameProgress": "writable",
    "p1PrevBreathDir": "writable",
    "p2PrevBreathDir": "writable",
    "p1BreathState": "writable",
    "p2BreathState": "writable",
    "meeraState": "writable",
    "meeraPatrolDir": "writable",
    "activeApparitionWalk": "writable",
    "apparitionGhost": "writable",
    "apparitionFadeTimer": "writable",
    "meeraFirstWhisperPlayed": "writable",
    "meeraSecondEventPlayed": "writable",
    "meeraFinalEventPlayed": "writable",
    "activeCountdownFlicker": "writable",
    "isBlackoutActive": "writable",
    "blackoutTriggered": "writable",
    "lockerAlertState": "writable",
    "lockerTargetToInspect": "writable",
    "statFearPeak": "writable",
    "p1HeartbeatSlowNode": "writable",
    "p1HeartbeatFastNode": "writable",
    "p2HeartbeatSlowNode": "writable",
    "p2HeartbeatFastNode": "writable"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "prefer-const": "off",
    "no-var": "warn",
    "no-empty": "off",
    "no-case-declarations": "off",
    "no-useless-escape": "off"
  }
}
