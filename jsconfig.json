{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "baseUrl": ".",
    "paths": { "@modules/*": ["src/modules/*"], "@/*": ["src/*"] }
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
